# ──────────────────────────────────────────────────────────────
# Estate — environment variables (placeholders only; copy to .env)
# Never commit real secret values. .env is git-ignored.
# ──────────────────────────────────────────────────────────────

# ── API server (Node/Express) ─────────────────────────────────
NODE_ENV=development
APP_NAME=estate-api
API_VERSION=v1
PORT=4000
# Comma-separated browser origins allowed by CORS. Local dev uses `*`.
# When unset (or `*`) any browser origin is accepted — safe because auth is
# bearer-token based, never cookies. Set the deployed frontend origin(s) to
# restrict access.
CORS_ORIGINS=*

# ── Frontend (Vite) ───────────────────────────────────────────
# Point the SPA at the API. Leave empty to keep the built-in mock
# layer (works inside the Figma Make preview with no backend).
# In production set this to the backend Render service root URL only —
# the app appends /api/v1 itself (no suffix here).
VITE_API_URL=

# ── PostgreSQL — Neon ─────────────────────────────────────────
# DATABASE_URL=postgresql://user:password@ep-example-xxxx-pooler.region.aws.neon.tech/estate?sslmode=require
# Set only when DATABASE_URL lacks an sslmode parameter:
# DB_SSL=true

# ── Auth ──────────────────────────────────────────────────────
# HMAC secret for HS256 access tokens. A long random secret. Production
# refuses to boot without one (dev fallback exists only outside production).
JWT_SECRET=replace-with-a-long-random-string

# ── Media (Cloudinary) — Phase 10 ─────────────────────────────
# Managed property/CMS images upload securely through Cloudinary. The cloud
# name and API key are public identifiers the signed direct-upload flow sends
# to the browser; the API SECRET is backend-only and must NEVER be exposed to
# the frontend (never prefix it with VITE_). Production refuses to boot without
# all three. Cloudinary API keys: Dashboard → Account → Access keys.
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── Admin bootstrap (Phase 10 — no hardcoded credentials) ─────
# Used ONLY by the seed script. In production the seed refuses to run without
# it; local/test runs fall back to a dev-only fixture so CI keeps working.
# SEED_ADMIN_PASSWORD=change-me-and-tell-nobody

# ── Email delivery (Phase 10) ──────────────────────────────────
# Pluggable transport. Leave unset (or "log") to deliver nothing but record
# every attempt in the email_deliveries ledger — ideal for dev/test and the
# free Render tier. Set EMAIL_PROVIDER=smtp plus the SMTP_* values below for
# real delivery through Nodemailer (Mailgun/SendGrid/any TLS-capable relay).
# Credentials live ONLY on the server — never prefix with VITE_ / never send
# to the browser.
# EMAIL_PROVIDER=log
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURE=false   # false = STARTTLS on 587; true = implicit TLS on 465
# SMTP_USER=your-smtp-username
# SMTP_PASS=your-smtp-password
# From address + display name used on every outbound email.
# SMTP_FROM_EMAIL=newsletter@estate.example
# SMTP_FROM_NAME=Estate
# Outward-facing base URL for links inside emails (unsubscribe, site links).
# Falls back to the API request origin when unset.
# EMAIL_BASE_URL=https://your-app.example

# HTTPS fallback provider — use when the host blocks SMTP egress (some Render
# plans filter port 465 and even 587). HTTPS egress is always allowed, so this
# is the reliable path on those hosts. The API key is server-only. The From
# address must be accepted by Resend: onboarding@resend.dev for testing, or a
# verified domain you own (a personal Gmail address cannot be used through
# Resend). Domain verification: resend.com/domains → add DNS records → verify.
# EMAIL_PROVIDER=resend
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=onboarding@resend.dev
# RESEND_FROM_NAME=Estate

# HMAC key used to derive newsletter unsubscribe tokens (server-side only).
# Add a long random string; production refuses to boot without it.
# UNSUBSCRIBE_SECRET=replace-with-a-long-random-string

# ── Test database (local/test only) ───────────────────────────
# Derives the isolated `estate_test` database from DATABASE_URL by swapping
# the database name. Tests never touch the production database.
# TEST_DATABASE_NAME=estate_test